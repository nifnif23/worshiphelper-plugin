name: Build WorshipHelper MSI

on:
  workflow_dispatch:

env:
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true

jobs:
  build:
    runs-on: windows-2022

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup MSBuild
        uses: microsoft/setup-msbuild@v2

      - name: Set WiX environment variable
        run: |
          $wixPath = (Get-ChildItem "C:\Program Files (x86)" -Filter "WiX Toolset*" | Select-Object -First 1).FullName
          echo "WIX=$wixPath" >> $env:GITHUB_ENV

      - name: Restore NuGet packages
        run: nuget restore WorshipHelper.sln

      # -----------------------------------------------------------------------
      # Discover actual DLL paths after restore and export as env vars.
      # This avoids hardcoding paths that change between NAudio sub-package
      # versions and avoids guessing the lib/net* folder name.
      # -----------------------------------------------------------------------
      - name: Resolve assembly HintPaths
        run: |
          $packagesDir = "$env:GITHUB_WORKSPACE\packages"

          $naudioCore = Get-ChildItem "$packagesDir\NAudio.Core.*\lib" -Recurse -Filter "NAudio.Core.dll" |
            Sort-Object { $_.FullName } | Select-Object -Last 1
          $naudioWinMM = Get-ChildItem "$packagesDir\NAudio.WinMM.*\lib" -Recurse -Filter "NAudio.WinMM.dll" |
            Sort-Object { $_.FullName } | Select-Object -Last 1
          $vosk = Get-ChildItem "$packagesDir\Vosk.*\lib" -Recurse -Filter "Vosk.dll" |
            Sort-Object { $_.FullName } | Select-Object -Last 1

          if (-not $naudioCore) { throw "NAudio.Core.dll not found under $packagesDir" }
          if (-not $naudioWinMM) { throw "NAudio.WinMM.dll not found under $packagesDir" }
          if (-not $vosk)        { throw "Vosk.dll not found under $packagesDir" }

          Write-Host "NAudio.Core  -> $($naudioCore.FullName)"
          Write-Host "NAudio.WinMM -> $($naudioWinMM.FullName)"
          Write-Host "Vosk         -> $($vosk.FullName)"

          echo "NAUDIO_CORE_PATH=$($naudioCore.FullName)"   >> $env:GITHUB_ENV
          echo "NAUDIO_WINMM_PATH=$($naudioWinMM.FullName)" >> $env:GITHUB_ENV
          echo "VOSK_PATH=$($vosk.FullName)"                >> $env:GITHUB_ENV

      # -----------------------------------------------------------------------
      # Download Vosk model (small ~50 MB, bundled into MSI for offline use)
      # -----------------------------------------------------------------------
      - name: Download Vosk speech model
        run: |
          $modelUrl  = "https://alphacephei.com/vosk/models/vosk-model-small-en-us-0.15.zip"
          $modelZip  = "$env:TEMP\vosk-model.zip"
          $modelDest = "$env:GITHUB_WORKSPACE\WorshipHelperVSTO\data\vosk-model"

          Write-Host "Downloading Vosk model..."
          Invoke-WebRequest -Uri $modelUrl -OutFile $modelZip -UseBasicParsing

          Write-Host "Extracting..."
          Expand-Archive -Path $modelZip -DestinationPath "$env:TEMP\vosk-extracted" -Force

          $inner = Get-ChildItem "$env:TEMP\vosk-extracted" | Select-Object -First 1
          Move-Item -Path $inner.FullName -Destination $modelDest -Force

          Write-Host "Vosk model ready at: $modelDest"

      # -----------------------------------------------------------------------
      # Certificate
      # -----------------------------------------------------------------------
      - name: Generate self-signed certificate
        run: |
          $cert = New-SelfSignedCertificate `
            -Subject "CN=WorshipHelper" `
            -CertStoreLocation "Cert:\CurrentUser\My" `
            -KeyExportPolicy Exportable `
            -KeySpec Signature `
            -KeyUsage DigitalSignature `
            -Type CodeSigningCert `
            -NotAfter (Get-Date).AddYears(5)
          $pwd = ConvertTo-SecureString -String "build123" -Force -AsPlainText
          $pfxPath = "$env:GITHUB_WORKSPACE\WorshipHelperVSTO\ci-cert.pfx"
          Export-PfxCertificate -Cert $cert -FilePath $pfxPath -Password $pwd | Out-Null

          $store = New-Object System.Security.Cryptography.X509Certificates.X509Store("My", "LocalMachine")
          $store.Open("ReadWrite")
          $store.Add($cert)
          $store.Close()

          echo "CERT_THUMBPRINT=$($cert.Thumbprint)" >> $env:GITHUB_ENV
          echo "PFX_PATH=$pfxPath" >> $env:GITHUB_ENV

      - name: Stamp build version
        run: |
          $runNumber = $env:GITHUB_RUN_NUMBER
          $versionLine = "[assembly: AssemblyFileVersion(`"1.4.0.$runNumber`")]"
          $path = "WorshipHelperVSTO\Properties\AssemblyInfo.cs"
          $content = Get-Content $path -Raw
          $content = $content -replace '(?m)^.*AssemblyFileVersion.*\r?\n', ''
          $content = $content.TrimEnd() + "`r`n$versionLine`r`n"
          Set-Content $path $content -NoNewline

      - name: Build VSTO (Release)
        run: |
          msbuild WorshipHelperVSTO\WorshipHelperVSTO.csproj `
            /p:Configuration=Release `
            /p:Platform=AnyCPU `
            /p:SignManifests=true `
            /p:GenerateClickOnceManifests=false `
            /p:ManifestCertificateThumbprint="$env:CERT_THUMBPRINT" `
            /p:ManifestKeyFile="$env:PFX_PATH" `
            /p:ManifestCertificatePassword=build123 `
            /p:NAudioCoreHintPath="$env:NAUDIO_CORE_PATH" `
            /p:NAudioWinMMHintPath="$env:NAUDIO_WINMM_PATH" `
            /p:VoskHintPath="$env:VOSK_PATH" `
            /verbosity:minimal

      # -----------------------------------------------------------------------
      # Copy NuGet runtime DLLs into bin\Release so the MSI can bundle them.
      # Vosk ships two pieces: Vosk.dll (managed) and libvosk.dll (native C).
      # NAudio ships as separate sub-packages. None are auto-copied by MSBuild
      # because they're referenced via HintPath rather than normal NuGet imports.
      # -----------------------------------------------------------------------
      - name: Copy NuGet DLLs to bin\Release
        run: |
          $targetDir  = "$env:GITHUB_WORKSPACE\WorshipHelperVSTO\bin\Release"
          $packagesDir = "$env:GITHUB_WORKSPACE\packages"

          # Managed wrappers (already resolved in earlier step)
          Copy-Item $env:VOSK_PATH        $targetDir -Force
          Copy-Item $env:NAUDIO_CORE_PATH $targetDir -Force
          Copy-Item $env:NAUDIO_WINMM_PATH $targetDir -Force

          # libvosk.dll — native C library that Vosk.dll P/Invokes into.
          # NuGet places it under runtimes/win/native/ or runtimes/win-x86/native/
          $libvosk = Get-ChildItem "$packagesDir\Vosk.*\runtimes" -Recurse -Filter "libvosk.dll" |
            Select-Object -First 1
          if (-not $libvosk) { throw "libvosk.dll not found in NuGet packages" }
          Write-Host "libvosk.dll -> $($libvosk.FullName)"
          Copy-Item $libvosk.FullName $targetDir -Force

      - name: Publish VSTO (With Signing)
        run: |
          msbuild WorshipHelperVSTO\WorshipHelperVSTO.csproj `
            /target:Publish `
            /p:Configuration=Release `
            /p:Platform=AnyCPU `
            /p:PublishDir="${{ github.workspace }}\WorshipHelperVSTO\publish\" `
            /p:SignManifests=true `
            /p:ManifestCertificateThumbprint="$env:CERT_THUMBPRINT" `
            /p:ManifestKeyFile="$env:PFX_PATH" `
            /p:ManifestCertificatePassword=build123 `
            /p:NAudioCoreHintPath="$env:NAUDIO_CORE_PATH" `
            /p:NAudioWinMMHintPath="$env:NAUDIO_WINMM_PATH" `
            /p:VoskHintPath="$env:VOSK_PATH" `
            /verbosity:normal

      - name: Remove VSTO project reference from WiX project
        run: |
          $wixproj = "WorshipHelperSetup\WorshipHelperSetup.wixproj"
          [xml]$xml = Get-Content $wixproj
          $ns = New-Object System.Xml.XmlNamespaceManager($xml.NameTable)
          $ns.AddNamespace("ms", "http://schemas.microsoft.com/developer/msbuild/2003")
          $refs = $xml.SelectNodes("//ms:ProjectReference", $ns)
          foreach ($ref in $refs) { $ref.ParentNode.RemoveChild($ref) | Out-Null }
          $xml.Save((Resolve-Path $wixproj))

      - name: Build MSI
        run: |
          $targetDir = "$env:GITHUB_WORKSPACE\WorshipHelperVSTO\bin\Release\"
          msbuild WorshipHelperSetup\WorshipHelperSetup.wixproj `
            /p:Configuration=Release `
            /p:Platform=x86 `
            /p:DefineConstants="WorshipHelperVSTO.TargetDir=$targetDir" `
            /verbosity:normal

      - name: Upload MSI artifact
        uses: actions/upload-artifact@v4
        with:
          name: WorshipHelperSetup
          path: WorshipHelperSetup\bin\Release\**\WorshipHelperSetup.msi
